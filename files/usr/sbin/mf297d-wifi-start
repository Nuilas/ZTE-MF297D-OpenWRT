#!/bin/sh
# Start the vendor radio firmware after netifd and firmware hotplug are ready.
for attempt in $(seq 1 60); do
 seconds=$(cut -d. -f1 /proc/uptime)
 if [ "$seconds" -ge 35 ] && ubus list network.wireless >/dev/null 2>&1; then
  break
 fi
 sleep 1
done
if ! ubus list network.wireless >/dev/null 2>&1; then
 logger -t mf297d-wifi 'netifd is unavailable; radio startup deferred'
 exit 1
fi
for module in qrtr qrtr-smd compat cfg80211 mac80211 ath qmi_helpers ath11k ath11k_ahb; do
 modprobe "$module" || exit 1
done
/sbin/wifi reload
logger -t mf297d-wifi 'radio drivers loaded and wireless reload requested'
