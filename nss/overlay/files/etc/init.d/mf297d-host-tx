#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
 [ "$(uci -q get mf297d_tuning.general.host_ipv4_checksum)" = '1' ] || return 0
 procd_open_instance
 procd_set_param command /usr/sbin/mf297d-host-tx watch
 procd_set_param respawn 3600 5 5
 procd_close_instance
}

stop_service() {
 /usr/sbin/mf297d-host-tx disable
}
