#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=97
STOP=10
USE_PROCD=1

start_service() {
 [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'zte,mf297d' ] || return 0
 [ -x /usr/bin/adb ] || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/mf297d-wifi-led
 procd_set_param respawn 3600 5 5
 procd_close_instance
}

stop_service() {
 /usr/sbin/mf297d-wifi-led --off || true
}
