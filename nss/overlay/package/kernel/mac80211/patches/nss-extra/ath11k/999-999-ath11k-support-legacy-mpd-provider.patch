Subject: [PATCH] ath11k: preserve the remoteproc-managed multi-PD binding

The native MF297D DT references MPD child remoteprocs. Reusing that binding
with the SEC lifecycle attempts to boot a child as the root, or claims the
same user-PD IRQs twice. Detect the remoteproc provider model, retain its
reference, and use its existing boot/shutdown lifecycle. Keep the SEC path
unchanged for bindings that reference the shared root.

---
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -597,6 +597,9 @@
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	int ret;
 
+	if (ab_ahb->legacy_rproc)
+		return rproc_boot(ab_ahb->legacy_rproc);
+
 	if (ab_ahb->userpd_id > 0 &&
 	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX) {
 		ret = ath11k_ahb_boot_user_pd(ab);
@@ -656,6 +659,11 @@
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 
+	if (ab_ahb->legacy_rproc) {
+		rproc_shutdown(ab_ahb->legacy_rproc);
+		return;
+	}
+
 	if (ab_ahb->userpd_id > 0 &&
 	    ab_ahb->userpd_id < ATH11K_AHB_USERPD_ID_MAX)
 		ath11k_ahb_stop_user_pd(ab);
@@ -711,6 +719,10 @@
 static bool ath11k_ahb_q6_running(struct ath11k_base *ab)
 {
 	struct ath11k_ahb_rproc_info *rproc_info = ath11k_ahb_priv(ab)->rproc_info;
+	struct rproc *legacy = ath11k_ahb_priv(ab)->legacy_rproc;
+
+	if (legacy)
+		return legacy->state == RPROC_RUNNING;
 
 	return rproc_info && rproc_info->tgt_rproc &&
 	       rproc_info->tgt_rproc->state == RPROC_RUNNING;
@@ -1502,9 +1514,54 @@
 	return ret;
 }
 
+/* Older multi-PD bindings reference a child remoteproc. Its driver owns
+ * firmware loading, M3 segments, spawn/stop IRQs and the parent boot reference.
+ * Do not also register ath11k's SEC/user-PD lifecycle on that child.
+ */
+static int ath11k_ahb_configure_legacy_rproc(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	struct device_node *node, *parent;
+	struct rproc *rproc;
+	unsigned int pd;
+	bool legacy;
+
+	node = of_parse_phandle(ab->dev->of_node, "qcom,rproc", 0);
+	if (!node)
+		return 0;
+	parent = of_get_parent(node);
+	legacy = of_device_is_compatible(parent, "qcom,ipq5018-q6-mpd") ||
+		 of_device_is_compatible(parent, "qcom,ipq5332-q6-mpd");
+	of_node_put(parent);
+	if (!legacy) {
+		of_node_put(node);
+		return 0;
+	}
+
+	if (sscanf(node->name, "pd-%u", &pd) != 1 || !pd || pd > 3) {
+		of_node_put(node);
+		return -EINVAL;
+	}
+	rproc = rproc_get_by_phandle(node->phandle);
+	of_node_put(node);
+	if (!rproc)
+		return -EPROBE_DEFER;
+
+	ab_ahb->legacy_rproc = rproc;
+	ab_ahb->userpd_id = pd;
+	if (ab->hw_rev == ATH11K_HW_QCN6122_HW10)
+		ab->qmi.service_ins_id += pd - 1;
+	ath11k_info(ab, "using MPD-managed userPD%u\n", pd);
+	return 1;
+}
+
 static int ath11k_ahb_configure_rproc(struct ath11k_base *ab)
 {
 	int ret;
+
+	ret = ath11k_ahb_configure_legacy_rproc(ab);
+	if (ret)
+		return ret < 0 ? ret : 0;
 
 	mutex_lock(&ath11k_rproc_info_lock);
 
@@ -1577,6 +1634,12 @@
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	struct ath11k_ahb_rproc_info *rproc_info = ab_ahb->rproc_info;
+
+	if (ab_ahb->legacy_rproc) {
+		rproc_put(ab_ahb->legacy_rproc);
+		ab_ahb->legacy_rproc = NULL;
+		return;
+	}
 
 	if (!rproc_info || !g_rproc_info)
 		return;
--- a/drivers/net/wireless/ath/ath11k/ahb.h
+++ b/drivers/net/wireless/ath/ath11k/ahb.h
@@ -85,6 +85,7 @@
 		struct qcom_smem_state *smem_state;
 	} smp2p_info;
 	struct ath11k_ahb_rproc_info *rproc_info;
+	struct rproc *legacy_rproc;
 
 	struct qcom_smem_state *spawn_state;
 	struct qcom_smem_state *stop_state;
